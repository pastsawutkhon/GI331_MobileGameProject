%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b62e1db2ada4550a8763c51bee55af1, type: 3}
  m_Name: ChapterVoiceLines
  m_EditorClassIdentifier:
  font: {fileID: 12800000, guid: 64c4f764faf33ca44be34f9eed5d2236, type: 3}
  lines:
  - id: S00_PAT_01
    speaker: "ธีรภัทร (คิด)"
    text: "สามเดือนแล้ว... ตั้งแต่พี่ชายของผมหายตัวไปอย่างไร้ร่องรอย"
  - id: S00_PAT_02
    speaker: "ธีรภัทร (คิด)"
    text: "เบาะแสสุดท้ายพาผมมาหยุดอยู่ที่โรงพยาบาลร้างแห่งนี้"
  - id: S00_PAT_03
    speaker: "ธีรภัทร (คิด)"
    text: "พี่ธีรวัฒน์... หวังว่าพี่จะยังปลอดภัยนะ"
  - id: S01_PAT_01
    speaker: "ธีรภัทร"
    text: "ล็อกโซ่ไว้แน่นเลย..."
  - id: S01_PAT_02
    speaker: "ธีรภัทร"
    text: "มืดขนาดนี้ มองรอบ ๆ แทบไม่เห็นเลย"
  - id: S01_PAT_03
    speaker: "ธีรภัทร"
    text: "ประตูหน้าโดนปิดตาย... ลองดูรอบ ๆ ดีกว่า เผื่อมีทางอื่น"
  - id: S02_PAT_01
    speaker: "ธีรภัทร"
    text: "แผนกเวชระเบียน... ลองเปิดตู้ดูดีกว่าว่าจะมีอะไรข้างใน"
  - id: S02_PAT_02
    speaker: "ธีรภัทร"
    text: "แต่ต้องใส่รหัสสามหลัก..."
  - id: S02_PAT_03
    speaker: "ธีรภัทร"
    text: "แฟ้มนี้... ธีรวัฒน์"
  - id: S02_PAT_04
    speaker: "ธีรภัทร"
    text: "นี่มันชื่อพี่ชายเรานี่นา!"
  - id: S02_PAT_05
    speaker: "ธีรภัทร"
    text: "ทำไมพี่ถึงมีประวัติอยู่ที่นี่ได้..."
  - id: S03_PAT_01
    speaker: "ธีรภัทร"
    text: "เหมือนจะมีรอยอยู่บนกระจก... รอยมันแปลกๆ แต่ก็อ่านไม่ออกเลย ... ต้องหาวิธีทำให้เห็นชัดขึ้น"
  - id: S03_PAT_02
    speaker: "ธีรภัทร"
    text: "เหมือนจะเยอะไป มีแต่ผงถ่านเกาะเต็มไปหมดเลย... หาอะไรมาปัดออกซะหน่อย"
  - id: S03_PAT_03
    speaker: "ธีรภัทร"
    text: "ห้องใต้บันได..."
  - id: S03_PAT_04
    speaker: "ธีรภัทร"
    text: "มีคนอยู่ที่นี่หรอ... หรือว่าใครเขียนข้อความนี้ทิ้งไว้ ... ลองไปดูหน่อยดีกว่า อาจจะเจออะไรบ้าง"
  - id: S04_PAT_01
    speaker: "ธีรภัทร"
    text: "พี่ธีรวัฒน์ก็มีชื่ออยู่ในนี้ด้วย!"
  - id: S04_PAT_02
    speaker: "ธีรภัทร"
    text: "ที่พี่หายไปแบบนี้มันยิ่งไม่ปกติแล้ว..."
  - id: S04_PAT_03
    speaker: "ธีรภัทร"
    text: "เฮ้ย! ใครปิดประตู!"
  - id: S04_PAT_04
    speaker: "ธีรภัทร"
    text: "เปิดไม่ออกด้วย..."
  - id: S04_PAT_05
    speaker: "ธีรภัทร"
    text: "เทียนพวกนี้วางเรียงแปลก ๆ... เหมือนสัญลักษณ์ที่เห็นผ่านกล้องเมื่อกี้เลย"
  - id: S04_PAT_06
    speaker: "ธีรภัทร"
    text: "มีทางลับอยู่ใต้พื้นจริง ๆ ด้วย..."
  - id: S04_PAT_07
    speaker: "ธีรภัทร"
    text: "แบบนี้มันไม่ใช่ที่ที่มีในโรงพยาบาลแล้ว... ต้องมีใครมาทำไว้แน่ๆ"
  - id: S05_PAT_01
    speaker: "ธีรภัทร"
    text: "เหมือนมีบางอย่างอยู่ข้างในตัวหุ่นเลย..."
  - id: S05_PAT_02
    speaker: "ธีรภัทร"
    text: "รูปคนสิบคน... เจ็ดคนถูกขีดฆ่าสีแดง"
  - id: S05_PAT_03
    speaker: "ธีรภัทร"
    text: "เดี๋ยวนะ อีกสามคนที่เหลือ..."
  - id: S05_PAT_04
    speaker: "ธีรภัทร"
    text: "แล้วนั่นมันรูปผมนี่! ทำไมรูปผมถึงมาอยู่ที่นี่ได้?!"
  - id: S05_PAT_05
    speaker: "ธีรภัทร"
    text: "มีSD-cardอยู่ตรงนี้... น่าจะเอาใส่กล้องดูได้ ลองดูดีกว่า"
  - id: S06_PAT_01
    speaker: "ธีรภัทร"
    text: "ไม่จริง... ไม่จริงใช่ไหม!"
  - id: S06_PAT_02
    speaker: "ธีรภัทร"
    text: "ภาพในคลิปนั่นมันอะไรกัน..."
  - id: S06_PAT_03
    speaker: "ธีรภัทร"
    text: "พี่... พี่ทำแบบนั้นได้ยังไง!"
  - id: S06_WAT_01
    speaker: "ธีรวัฒน์"
    text: "ในที่สุดก็หาเจอจนได้นะ... ธีรภัทร"
  - id: S06_PAT_04
    speaker: "ธีรภัทร"
    text: "พะ... พี่ธีรวัฒน์?!"
  - id: S06_PAT_05
    speaker: "ธีรภัทร"
    text: "อย่าเข้ามา! ผมเห็นหมดแล้ว!"
  - id: S06_PAT_06
    speaker: "ธีรภัทร"
    text: "ทางตันอีก... ไม่มีทางหนีแล้ว!"
  - id: S06_WAT_02
    speaker: "ธีรวัฒน์"
    text: "ยอมแพ้เถอะ น้องรัก"
  - id: S06_WAT_03
    speaker: "ธีรวัฒน์"
    text: "พี่กำลังจะช่วยให้แกได้เป็นส่วนหนึ่งของพวกเรา..."
  - id: S06_PAT_07
    speaker: "ธีรภัทร"
    text: "ทำแบบนี้ทำไม! แกมันไม่ใช่คนแล้ว!"
  - id: S06_PAT_08
    speaker: "ธีรภัทร"
    text: "อย่าเข้ามานะ!"
  - id: END_A_PAT_01
    speaker: "ธีรภัทร"
    text: "เข้ามาสิ! ผมไม่ยอมตายง่าย ๆ หรอก!"
  - id: END_B_PAT_01
    speaker: "ธีรภัทร"
    text: "ฝันไปเถอะ!! ถ้าผมต้องเป็นแบบพี่น่ะ... ขอตายดีกว่าา!!!"
